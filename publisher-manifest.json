px;max-width:640px;color:#3c2f31;margin:0 0 30px}\n  h2{font-size:clamp(21px,3vw,27px);margin:64px 0 6px;letter-spacing:-.01em}\n  h2 .num{display:inline-block;font-size:12px;letter-spacing:.16em;color:var(--ivory);background:var(--wine);padding:3px 9px;margin-right:10px;vertical-align:3px}\n  h3{font-size:17px;margin:0 0 8px}\n  p{margin:0 0 14px}\n  .sub{color:var(--muted);font-size:14px;margin:0 0 26px}\n\n  /* 仪表盘式首屏数据块 */\n  .dash{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:0 0 14px}\n  .tile{border:2px solid var(--line);background:var(--ivory-2);padding:16px 15px 14px;min-height:132px;display:flex;flex-direction:column;justify-content:space-between}\n  .tile .k{font-size:11px;letter-spacing:.14em;color:var(--muted)}\n  .tile .v{font-size:clamp(23px,3.4vw,31px);font-weight:800;line-height:1.1;letter-spacing:-.02em}\n  .tile .v small{font-size:13px;font-weight:600;margin-left:3px}\n  .tile .note{font-size:12px;color:var(--muted);line-height:1.5}\n  .tile.dark{background:var(--wine);color:var(--ivory);border-color:var(--wine-deep)}\n  .tile.dark .k,.tile.dark .note{color:rgba(247,243,233,.75)}\n  .tile.wide{grid-column:span 2}\n  .board{border:2px solid var(--line);border-top:none;display:grid;grid-template-columns:1.5fr 1fr}\n  .board .cell{padding:18px 20px}\n  .board .cell + .cell{border-left:2px solid var(--line)}\n  .board .cell .lbl{font-size:11px;letter-spacing:.14em;color:var(--muted);display:block;margin-bottom:6px}\n  .board .cell p{margin:0;font-size:14px}\n\n  /* 阶梯式套餐 */\n  .stairs{display:grid;gap:18px;margin-top:26px}\n  .step{border:2px solid var(--line);background:#fbf8f1;padding:22px 24px;position:relative}\n  .step:nth-child(2){margin-left:26px}\n  .step:nth-child(3){margin-left:52px}\n  .step .ribbon{position:absolute;top:-2px;right:-2px;background:var(--wine);color:var(--ivory);font-size:11px;letter-spacing:.14em;padding:5px 12px}\n  .step .top{display:flex;flex-wrap:wrap;gap:8px 20px;align-items:flex-end;justify-content:space-between;border-bottom:1px solid #d8cfbd;padding-bottom:12px;margin-bottom:14px}\n  .step .price{font-size:26px;font-weight:800;letter-spacing:-.02em}\n  .step .price span{font-size:13px;font-weight:500;color:var(--muted);margin-left:6px}\n  .step .annual{font-size:13px;color:var(--wine);margin-top:2px}\n  .step ul{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:6px 20px;font-size:14px}\n  .step ul li{padding-left:16px;position:relative}\n  .step ul li::before{content:\"—\";position:absolute;left:0;color:var(--wine)}\n  .step .fit{margin-top:14px;font-size:13px;color:var(--muted);border-top:1px dashed #d8cfbd;padding-top:12px}\n\n  /* 使用说明卡片：粗描边直角 */\n  .usage{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:24px}\n  .ucard{border:2px solid var(--line);padding:18px 18px 20px;background:#fbf8f1}\n  .ucard .n{font-size:12px;letter-spacing:.16em;color:var(--wine);display:block;margin-bottom:8px}\n  .ucard p{font-size:14px;margin:0}\n\n  /* 设备区块 */\n  .clients{margin-top:24px;border:2px solid var(--line)}\n  .clients .row{display:grid;grid-template-columns:180px 1fr;border-bottom:1px solid #d8cfbd}\n  .clients .row:last-child{border-bottom:none}\n  .clients .row .name{padding:16px 18px;background:var(--ivory-2);font-weight:700;font-size:14px;border-right:2px solid var(--line)}\n  .clients .row .desc{padding:16px 18px;font-size:14px}\n\n  /* FAQ 分组 */\n  .faq-group{margin-top:26px;border-top:2px solid var(--line);padding-top:16px}\n  .faq-group > h3{display:inline-block;background:var(--wine);color:var(--ivory);padding:5px 13px;font-size:14px;letter-spacing:.06em;margin-bottom:12px}\n  details{border-bottom:1px solid #d8cfbd;padding:12px 0}\n  details:last-child{border-bottom:none}\n  summary{cursor:pointer;font-weight:600;font-size:15px;list-style:none;display:flex;gap:10px;align-items:flex-start}\n  summary::-webkit-details-marker{display:none}\n  summary::before{content:\"+\";color:var(--wine);font-weight:800;flex:0 0 auto;width:14px}\n  details[open] summary::before{content:\"–\"}\n  details p{margin:10px 0 0 24px;font-size:14px;color:#3c2f31}\n\n  .foot{max-width:960px;padding:34px 34px 0;margin-top:56px;border-top:2px solid var(--line);font-size:13px;color:var(--muted)}\n  .foot strong{color:var(--wine)}\n\n  @media (max-width:900px){\n    .dash{grid-template-columns:repeat(2,1fr)}\n    .step ul{grid-template-columns:1fr}\n    .usage{grid-template-columns:1fr}\n    .clients .row{grid-template-columns:1fr}\n    .clients .row .name{border-right:none;border-bottom:1px solid #d8cfbd}\n  }\n  @media (max-width:760px){\n    .layout{display:block}\n    .side{position:static;width:auto;flex:none;min-height:0;padding:20px 20px 22px}\n    .side nav ul{display:flex;flex-wrap:wrap;gap:4px 6px}\n    .side nav li{margin:0}\n    .side nav a{padding:6px 10px;border-left:none;border:1px solid rgba(247,243,233,.4);font-size:13px}\n    .side nav a:hover,.side nav a:focus{border-left-color:rgba(247,243,233,.4)}\n    .side .side-note{margin-top:18px}\n    .wrap{padding:0 20px}\n    .step:nth-child(2),.step:nth-child(3){margin-left:0}\n    .board{grid-template-columns:1fr}\n    .board .cell + .cell{border-left:none;border-top:2px solid var(--line)}\n    .foot{padding:26px 20px 0}\n  }\n</style><div class=\"layout\">\n  <aside class=\"side\">\n    <span class=\"mark\">CloudFox<small>SUBSCRIPTION NOTES</small></span>\n    <nav aria-label=\"页面目录\">\n      <ul>\n        <li><a href=\"#overview\">用量总览</a></li>\n        <li><a href=\"#plans\">套餐阶梯</a></li>\n        <li><a href=\"#how\">怎么用起来</a></li>\n        <li><a href=\"#clients\">设备与客户端</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ul>\n    </nav>\n    <div class=\"side-note\">\n      这一页把套餐、设备数量和使用顺序摊开写，方便你对着自己的情况做决定。\n    </div>\n  </aside>\n\n  <div class=\"content\">\n    <main class=\"wrap\">\n      <div class=\"masthead\">\n        <span class=\"tag\"><strong>CloudFox</strong> ／ 订阅说明</span>\n        <span class=\"tag\">本页内容以文字说明为主</span>\n      </div>\n\n      <h1>先把用量想清楚，<br>再决定 <span class=\"hl\">CloudFox</span> 怎么订</h1>\n      <p class=\"lede\">订阅这件事，说到底是把自己的使用节奏和套餐对上。下面这几块数据是三种方案的核心差别，你可以先扫一眼，再往下看细节。</p>\n\n      <section id=\"overview\">\n        <h2 id=\"overview-h\"><span class=\"num\">01</span>用量总览</h2>\n        <div class=\"dash\">\n          <div class=\"tile\">\n            <span class=\"k\">入门月流量</span>\n            <span class=\"v\">100<small>GB</small></span>\n            <span class=\"note\">基础版每月额度</span>\n          </div>\n          <div class=\"tile\">\n            <span class=\"k\">主力月流量</span>\n            <span class=\"v\">300<small>GB</small></span>\n            <span class=\"note\">旗舰版每月额度</span>\n          </div>\n          <div class=\"tile\">\n            <span class=\"k\">团队月流量</span>\n            <span class=\"v\">1000<small>GB</small></span>\n            <span class=\"note\">团队版每月额度</span>\n          </div>\n          <div class=\"tile dark\">\n            <span class=\"k\">同时在线设备</span>\n            <span class=\"v\">3 / 5 / 20</span>\n            <span class=\"note\">三种方案分别对应的上限</span>\n          </div>\n        </div>\n        <div class=\"board\">\n          <div class=\"cell\">\n            <span class=\"lbl\">怎么读这几组数字</span>\n            <p>流量是每月重置的额度，设备数是在线数量上限，两者互不替代。选的时候先看设备数够不够，再看流量余量是否舒服。</p>\n          </div>\n          <div class=\"cell\">\n            <span class=\"lbl\">付款周期</span>\n            <p>三种方案都提供按月与按年两种节奏，按年付的单价比月付更低，具体金额写在下面的套餐阶梯里。</p>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"plans\">\n        <h2 id=\"plans-h\"><span class=\"num\">02</span>套餐阶梯</h2>\n        <p class=\"sub\">从少到多三级台阶，按你的实际用量往上走一格就够了，不必提前预支用不上的部分。</p>\n\n        <div class=\"stairs\">\n          <article class=\"step\">\n            <div class=\"top\">\n              <div>\n                <h3>基础版</h3>\n                <div class=\"price\">¥15<span>/ 月</span></div>\n                <div class=\"annual\">按年付 ¥150 / 年，相当于省下两个月</div>\n              </div>\n            </div>\n            <ul>\n              <li>每月 100GB 流量额度</li>\n              <li>最多 3 台设备同时在线</li>\n              <li>支持解锁基础流媒体内容</li>\n              <li>使用普通线路节点池</li>\n            </ul>\n            <p class=\"fit\">适合：一个人用，手机加一台电脑，日常浏览和看剧为主。</p>\n          </article>\n\n          <article class=\"step\">\n            <span class=\"ribbon\">多数人选择</span>\n            <div class=\"top\">\n              <div>\n                <h3>旗舰版</h3>\n                <div class=\"price\">¥35<span>/ 月</span></div>\n                <div class=\"annual\">按年付 ¥350 / 年，相当于省下两个月</div>\n              </div>\n            </div>\n            <ul>\n              <li>每月 300GB 流量额度</li>\n              <li>最多 5 台设备同时在线</li>\n              <li>全节点支持原生流媒体解锁</li>\n              <li>IPLC 专线，针对游戏优化</li>\n              <li>7×24 优先工单支持</li>\n            </ul>\n            <p class=\"fit\">适合：手机、平板、电脑同时在用，偶尔玩游戏，希望线路更稳一点的家庭或个人。</p>\n          </article>\n\n          <article class=\"step\">\n            <div class=\"top\">\n              <div>\n                <h3>团队版</h3>\n                <div class=\"price\">¥85<span>/ 月</span></div>\n                <div class=\"annual\">按年付 ¥850 / 年，相当于省下两个月</div>\n              </div>\n            </div>\n            <ul>\n              <li>每月 1000GB 流量额度</li>\n              <li>最多 20 台设备同时在线</li>\n              <li>VIP 专属高带宽节点</li>\n              <li>支持企业定制路由</li>\n              <li>配置专属客户经理</li>\n            </ul>\n            <p class=\"fit\">适合：小团队、工作室，或者一个人设备特别多、需要按团队方式管理的情况。</p>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"how\">\n        <h2 id=\"how-h\"><span class=\"num\">03</span>怎么用起来</h2>\n        <p class=\"sub\">订阅之后的顺序其实很简单，三步就能进入正常使用状态。</p>\n        <div class=\"usage\">\n          <article class=\"ucard\">\n            <span class=\"n\">STEP 01</span>\n            <h3>先确认方案</h3>\n            <p>对照上面的设备数与流量额度，确认自己选的是哪一档，记下套餐名，后面的操作都以它为准。</p>\n          </article>\n          <article class=\"ucard\">\n            <span class=\"n\">STEP 02</span>\n            <h3>在设备上配置</h3>\n            <p>按你使用的系统找到对应的客户端，把订阅信息填进去。多台设备就重复这一步，注意别超过方案允许的同时在线数量。</p>\n          </article>\n          <article class=\"ucard\">\n            <span class=\"n\">STEP 03</span>\n            <h3>留意用量节奏</h3>\n            <p>额度是按月计算的，月中看一下剩余量，如果长期吃紧，往上一级台阶换档比勉强省着用更省心。</p>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"clients\">\n        <h2 id=\"clients-h\"><span class=\"num\">04</span>设备与客户端</h2>\n        <p class=\"sub\">CloudFox 的订阅可以在常见的桌面与移动系统上配置使用，具体客户端以你系统上实际可获取的版本为准。</p>\n        <div class=\"clients\">\n          <div class=\"row\">\n            <div class=\"name\">桌面系统</div>\n            <div class=\"desc\">Windows 与 macOS 上可配置订阅，适合把工作电脑和家用电脑纳入同一个方案。下载方式请以官方渠道公布的信息为准，本页不提供下载链接。</div>\n          </div>\n          <div class=\"row\">\n            <div class=\"name\">移动设备</div>\n            <div class=\"desc\">iOS 与 Android 均可配置使用，出差或通勤时接续同一份订阅。手机与平板会各自占用一个同时在线名额。</div>\n          </div>\n          <div class=\"row\">\n            <div class=\"name\">路由器与固定设备</div>\n            <div class=\"desc\">如果你希望整屋共用，可以在路由器层面配置，设备数量仍按方案上限计算。团队版的定制路由需求可联系客户经理沟通。</div>\n          </div>\n          <div class=\"row\">\n            <div class=\"name\">设备数量提醒</div>\n            <div class=\"desc\">基础版 3 台、旗舰版 5 台、团队版 20 台，指同一时间在线的设备数量。超出时先退出一台，再接入新的设备。</div>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"faq\">\n        <h2 id=\"faq-h\"><span class=\"num\">05</span>常见问题</h2>\n        <p class=\"sub\">按大家最常问的三类整理：挑套餐、用设备、改方案。</p>\n\n        <div class=\"faq-group\">\n          <h3>关于挑套餐</h3>\n          <details>\n            <summary>我不太确定自己一个月会用多少流量，怎么选？</summary>\n            <p>先按设备数筛一遍：家里几台设备常同时在线，就决定了你至少需要哪一档。设备数够用之后，再看流量——如果平时主要是网页、文档和少量视频，100GB 通常有余量；如果经常长时间看高清视频或下载大文件，从 300GB 起步更踏实。</p>\n          </details>\n          <details>\n            <summary>旗舰版比基础版贵的那部分，值在哪里？</summary>\n            <p>差在三处：流量从 100GB 提到 300GB，同时在线设备从 3 台提到 5 台，另外多了全节点流媒体解锁、IPLC 专线游戏优化和优先工单支持。如果你同时用手机和电脑、又在意游戏时的线路表现，这部分的差别会比较明显。</p>\n          </details>\n          <details>\n            <summary>按年付和按月付有什么区别？</summary>\n            <p>额度、设备数和权益完全一样，区别只在付款节奏和单价。按年付的价格分别是 ¥150、¥350、¥850，折合下来比按月付省下两个月的费用。如果你打算长期用，按年付更划算；如果是先试试，按月付更灵活。</p>\n          </details>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>关于设备和客户端</h3>\n          <details>\n            <summary>同一份订阅可以给几台设备用？</summary>\n            <p>取决于你的方案：基础版 3 台、旗舰版 5 台、团队版 20 台，指的是同时在线数量。你可以在更多设备上保存配置，但只要同一时间不超上限就没问题。</p>\n          </details>\n          <details>\n            <summary>为什么不能把配置分享给朋友一起用？</summary>\n            <p>因为同时在线数量是按方案计算的，多人共用会很快占满名额，也会影响你自己设备的接入。如果确实有多人需求，团队版在设备数和流量上都留了余量，更适合这种场景。</p>\n          </details>\n          <details>\n            <summary>换了一台新设备，需要重新买套餐吗？</summary>\n            <p>不需要。在新设备上按原来的订阅信息配置即可，只要在线设备总数不超过方案上限。旧设备不再使用时，退出配置就能腾出名额。</p>\n          </details>\n        </div>\n\n        <div class=\"faq-group\">\n          <h3>关于升级和调整</h3>\n          <details>\n            <summary>用着用着流量不够了，可以升到上一档吗？</summary>\n            <p>可以从基础版往旗舰版、旗舰版往团队版调整。考虑到跨月计费的细节各家处理方式不同，建议在调整前先联系支持确认当月额度和费用的衔接方式，再做操作。</p>\n          </details>\n          <details>\n            <summary>团队版里的“定制路由”是指什么？</summary>\n            <p>是针对团队网络结构做线路与分流方面的配置安排，具体能做到什么程度需要和客户经理按你的实际情况聊。这一项属于团队版权益，基础版与旗舰版不包含。</p>\n          </details>\n          <details>\n            <summary>遇到问题时，怎么联系支持？</summary>\n            <p>旗舰版包含 7×24 优先工单支持，团队版另配专属客户经理。基础版的用户也可以提交工单，只是响应优先级不同。提交时写清楚方案名称、设备和具体现象，会更快定位。</p>\n          </details>\n        </div>\n      </section>\n    </main>\n\n    <div class=\"foot\">\n      <p><strong>CloudFox</strong> · 本页为订阅说明与套餐信息展示，价格与权益以上方正文为准。客户端获取渠道请以官方发布的信息为准，本页不提供下载地址。</p>\n    </div>\n  </div>\n</div>",
